{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "bp-review-0.2"
    },
    "poc_only": {
      "type": "boolean",
      "const": true
    },
    "knowledge_base_version": {
      "type": "string",
      "const": "au-register-0.1"
    },
    "ruleset_version": {
      "type": "string",
      "enum": [
        "bp3-0.4",
        "bp3-0.5",
        "bp3-0.6",
        "bp3-0.7",
        "bp3-0.8",
        "bp3-0.9",
        "bp3-0.10",
        "bp3-0.11",
        "bp3-0.12",
        "bp3-0.13",
        "bp3-0.14",
        "bp3-0.15"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "code_return_mode": {
      "type": "string",
      "const": "none"
    },
    "target": {
      "type": "object",
      "properties": {
        "asset_type": {
          "type": "string",
          "enum": [
            "business_rule",
            "client_script"
          ]
        },
        "asset_table": {
          "type": "string",
          "enum": [
            "sys_script",
            "sys_script_client"
          ]
        },
        "asset_sys_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "sys_scope": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                },
                {
                  "type": "string",
                  "const": "global"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "field": {
          "type": "string",
          "const": "script"
        },
        "code_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "record_updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_version": {
          "type": "string",
          "const": "update_set_payload"
        },
        "update_set_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "update_xml_sys_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "asset_type",
        "asset_table",
        "asset_sys_id",
        "sys_scope",
        "field",
        "code_hash",
        "retrieved_at",
        "record_updated_at",
        "target_version",
        "update_set_id",
        "update_xml_sys_id",
        "payload_hash"
      ],
      "additionalProperties": false
    },
    "instance_release": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "operator_config"
            },
            "resolution_status": {
              "type": "string",
              "const": "asserted"
            },
            "family": {
              "type": "string",
              "enum": [
                "Australia",
                "Brazil",
                "Zurich",
                "Yokohama",
                "Xanadu"
              ]
            },
            "visibility_scope": {
              "type": "string",
              "const": "operator_configured"
            },
            "instance_binding": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "config_version": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "asserted_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "source",
            "resolution_status",
            "family",
            "visibility_scope",
            "instance_binding",
            "config_version",
            "asserted_at",
            "expires_at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "sys_cluster_state.build_name"
            },
            "resolution_status": {
              "type": "string",
              "const": "resolved"
            },
            "family": {
              "type": "string",
              "enum": [
                "Australia",
                "Brazil",
                "Zurich",
                "Yokohama",
                "Xanadu"
              ]
            },
            "raw_buildname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "visibility_scope": {
              "type": "string",
              "const": "caller_acl"
            }
          },
          "required": [
            "source",
            "resolution_status",
            "family",
            "raw_buildname",
            "observed_at",
            "visibility_scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "conflict"
            },
            "resolution_status": {
              "type": "string",
              "const": "unknown"
            },
            "family": {
              "type": "null"
            },
            "observed_families": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Australia",
                  "Brazil",
                  "Zurich",
                  "Yokohama",
                  "Xanadu"
                ]
              }
            },
            "configured_family": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "Australia",
                    "Brazil",
                    "Zurich",
                    "Yokohama",
                    "Xanadu"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "visibility_scope": {
              "type": "string",
              "const": "caller_acl"
            }
          },
          "required": [
            "source",
            "resolution_status",
            "family",
            "observed_families",
            "configured_family",
            "observed_at",
            "visibility_scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "none"
            },
            "resolution_status": {
              "type": "string",
              "const": "unknown"
            },
            "family": {
              "type": "null"
            },
            "visibility_scope": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "enum": [
                "not_configured",
                "observation_unavailable",
                "config_expired",
                "config_validity_insufficient",
                "config_binding_mismatch",
                "observation_incomplete",
                "observation_inconsistent",
                "observation_limit"
              ]
            }
          },
          "required": [
            "source",
            "resolution_status",
            "family",
            "visibility_scope",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "release_match": {
      "type": "string",
      "enum": [
        "matched",
        "mismatched",
        "unknown"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "requested_rule_ids": {
          "minItems": 1,
          "maxItems": 14,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AU-BR-001",
              "AU-BR-002",
              "AU-CL-004",
              "AU-QRY-001",
              "AU-BR-004",
              "AU-BR-005",
              "AU-BR-007",
              "AU-CL-006",
              "AU-CL-002",
              "AU-CL-008",
              "AU-CL-003",
              "AU-CL-007",
              "AU-CL-005",
              "AU-QRY-002"
            ]
          }
        },
        "evaluated_rule_ids": {
          "maxItems": 14,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "AU-BR-001",
              "AU-BR-002",
              "AU-CL-004",
              "AU-QRY-001",
              "AU-BR-004",
              "AU-BR-005",
              "AU-BR-007",
              "AU-CL-006",
              "AU-CL-002",
              "AU-CL-008",
              "AU-CL-003",
              "AU-CL-007",
              "AU-CL-005",
              "AU-QRY-002"
            ]
          }
        },
        "skipped_rules": {
          "maxItems": 14,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "enum": [
                  "AU-BR-001",
                  "AU-BR-002",
                  "AU-CL-004",
                  "AU-QRY-001",
                  "AU-BR-004",
                  "AU-BR-005",
                  "AU-BR-007",
                  "AU-CL-006",
                  "AU-CL-002",
                  "AU-CL-008",
                  "AU-CL-003",
                  "AU-CL-007",
                  "AU-CL-005",
                  "AU-QRY-002"
                ]
              },
              "reason": {
                "type": "string",
                "enum": [
                  "missing_context",
                  "release_mismatch",
                  "release_unknown",
                  "source_unapproved",
                  "unsupported",
                  "retrieval_failed"
                ]
              }
            },
            "required": [
              "rule_id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requested_rule_ids",
        "evaluated_rule_ids",
        "skipped_rules"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "findings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": [
              "AU-BR-001",
              "AU-BR-002",
              "AU-CL-004",
              "AU-QRY-001",
              "AU-BR-004",
              "AU-BR-005",
              "AU-BR-007",
              "AU-CL-006",
              "AU-CL-002",
              "AU-CL-008",
              "AU-CL-003",
              "AU-CL-007",
              "AU-CL-005",
              "AU-QRY-002"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "security",
              "performance",
              "maintainability",
              "correctness"
            ]
          },
          "severity": {
            "type": "string",
            "const": "info"
          },
          "confidence": {
            "type": "string",
            "const": "low"
          },
          "verification_status": {
            "type": "string",
            "const": "candidate"
          },
          "field": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "line_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "applicability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "required_follow_up": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "source_approval",
                "binding_and_reachability",
                "exceptions_and_business_intent",
                "workflow_suppression_review",
                "async_dependency_review",
                "synchronous_ajax_review",
                "shared_binding_intent_review",
                "post_abort_processing_review",
                "display_persistence_intent_review",
                "ui_policy_suitability_review",
                "client_lookup_necessity_review",
                "onchange_loading_intent_review",
                "onload_data_timing_review",
                "dom_dependency_review",
                "reference_display_value_review",
                "fulltext_index_configuration_review",
                "onload_static_inputs_review",
                "onload_runtime_inputs_review",
                "onload_unknown_inputs_review",
                "dom_document_scope_review",
                "dom_created_subtree_review",
                "fulltext_add_query_review",
                "fulltext_encoded_query_review"
              ]
            }
          },
          "sources": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "enum": [
                    "AU-SRC-001",
                    "AU-SRC-002",
                    "AU-SRC-003",
                    "AU-SRC-004",
                    "AU-SRC-005"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                },
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "release": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "verified_on": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "retrieved_at": {
                  "type": "null"
                },
                "content_hash": {
                  "type": "null"
                },
                "snapshot_id": {
                  "type": "null"
                },
                "catalog_version": {
                  "type": "string",
                  "const": "au-register-0.1"
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "source_id",
                "url",
                "section",
                "title",
                "release",
                "verified_on",
                "retrieved_at",
                "content_hash",
                "snapshot_id",
                "catalog_version",
                "summary"
              ],
              "additionalProperties": false
            }
          },
          "verification_evidence": {
            "maxItems": 0,
            "type": "array",
            "items": {
              "not": {}
            }
          }
        },
        "required": [
          "rule_id",
          "category",
          "severity",
          "confidence",
          "verification_status",
          "field",
          "line_start",
          "line_end",
          "issue",
          "impact",
          "applicability",
          "recommendation",
          "required_follow_up",
          "sources",
          "verification_evidence"
        ],
        "additionalProperties": false
      }
    },
    "instance_binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "poc_only",
    "knowledge_base_version",
    "ruleset_version",
    "reviewed_at",
    "review_status",
    "code_return_mode",
    "target",
    "instance_release",
    "release_match",
    "coverage",
    "limitations",
    "findings",
    "instance_binding"
  ],
  "additionalProperties": false,
  "$id": "urn:servicenow-mcp:best-practice-review-result:0.2",
  "$comment": "PoC only. Structural schema; also run reviewResultV2Schema for evidence time/binding, coverage, source and candidate checks. Does not establish truth or resolve releases."
}
