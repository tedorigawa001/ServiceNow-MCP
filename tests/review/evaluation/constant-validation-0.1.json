{
  "version":"constant-validation-0.1",
  "provenance":"18 new synthetic cases authored before first measurement of this set. Author has seen the implementation and prior cases, so this is not blind or IID. Expectations remain frozen after measurement; no tuning against this set. Five declared-scope cases and one semantic boundary per rule.",
  "cases":[
    {"id":"CONST-W01","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"const_boolean_chain","code":"const enabledForValidation = true;\nconst disableForValidation = !enabledForValidation;\ncurrent.setWorkflow(disableForValidation);\ncurrent.update('new-constant-workflow');","expected":[{"line":4,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"初期化済みconstと単項真偽値演算。"},
    {"id":"CONST-W02","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"conditional_boolean","code":"const useHooksForValidation = ('mode-a' === 'mode-b') ? true : false;\ncurrent.setWorkflow(useHooksForValidation);\ncurrent.update('new-conditional-workflow');","expected":[{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"既知文字列の厳密比較と条件式。"},
    {"id":"CONST-W03","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"short_circuit_boolean","code":"current.setWorkflow((true && false) || false);\ncurrent.update('new-logical-workflow');","expected":[{"line":2,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"限定された真偽値論理式のfalse。"},
    {"id":"CONST-W04","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"const_shadow","code":"const switchForValidation = false;\n{ const switchForValidation = true; current.setWorkflow(switchForValidation); }\ncurrent.update('new-shadowed-workflow');","expected":[{"line":3,"followup":false}],"limitations":[],"rationale":"外側falseで内側trueを取り違えない。"},
    {"id":"CONST-W05","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"unknown_boolean","code":"const suppliedForValidation = gs.getProperty('u_hook_mode');\ncurrent.setWorkflow(suppliedForValidation);\ncurrent.update('new-unresolved-workflow');","expected":[{"line":3,"followup":false}],"limitations":[],"rationale":"呼び出し結果をfalseと推測しない。更新候補自体は保持する。"},
    {"id":"CONST-W06","rule_id":"AU-BR-001","basis":"semantic_boundary","scenario":"builtin_call_excluded","code":"current.setWorkflow(Boolean(false));\ncurrent.update('new-builtin-workflow');","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"意味上はfalseでも関数呼び出し評価は範囲外。"},
    {"id":"CONST-A01","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"const_method_fragments","when":"async_always","code":"const verbForValidation = 'changes';\nconst methodForValidation = verbForValidation + 'To';\ncurrent.u_validation_route[methodForValidation]('center');","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"文字列constの連鎖とメソッド名。"},
    {"id":"CONST-A02","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"conditional_method","when":"async_always","code":"const methodForValidation = !false ? 'changesFrom' : 'getValue';\ncurrent.u_validation_route[methodForValidation]('edge');","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"既知条件の選択先だけでAPI名を確定。"},
    {"id":"CONST-A03","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"constant_container_key","when":"async_always","code":"const containerForValidation = { old: previous };\nconst keyForValidation = 'o' + 'ld';\ncontainerForValidation[keyForValidation].getValue('u_validation_route');","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"固定コンテナ参照でも解決したキーを一貫して使う。"},
    {"id":"CONST-A04","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"local_receiver_with_constant_method","when":"async_always","code":"const localForValidation = { changesTo: function() { return true; } };\nconst methodForValidation = 'changes' + 'To';\nlocalForValidation[methodForValidation]('local');","expected":[],"limitations":[],"rationale":"キー解決だけでローカル受信側をプラットフォームとしない。"},
    {"id":"CONST-A05","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"non_async_constant_method","when":"before_display","code":"const methodForValidation = 'changes' + 'From';\ncurrent.u_validation_route[methodForValidation]('display');","expected":[],"limitations":[],"rationale":"定数評価で非同期の適用条件を迂回しない。"},
    {"id":"CONST-A06","rule_id":"AU-BR-002","basis":"semantic_boundary","scenario":"join_call_excluded","when":"async_always","code":"const partsForValidation = ['changes', 'To'];\ncurrent.u_validation_route[partsForValidation.join('')]('joined');","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"join等の呼び出しは実行も推測もしない。"},
    {"id":"CONST-J01","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"nested_string_concat","code":"const requestForValidation = new GlideAjax('UnseenConcatReader');\nrequestForValidation[('get' + 'XML') + 'Wait']();","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"ネストした文字列結合。"},
    {"id":"CONST-J02","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"boolean_const_method_selection","code":"const synchronousForValidation = true && !false;\nconst methodForValidation = synchronousForValidation ? 'getXMLWait' : 'getXML';\nnew GlideAjax('UnseenConditionalReader')[methodForValidation]();","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"真偽値constから同期API名を選択する。"},
    {"id":"CONST-J03","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"unknown_receiver_retained","code":"const bagForValidation = { row: new GlideAjax('UnseenBagReader') };\nconst unresolvedIndexForValidation = g_form.getValue('u_bag_key');\nbagForValidation[unresolvedIndexForValidation].getXMLWait();","expected":[{"line":3,"followup":true}],"limitations":["synchronous_ajax_receiver_unresolved"],"rationale":"未解決キーから受信側を安全なローカル値として抑制しない。"},
    {"id":"CONST-J04","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"shadowed_const_selects_async","code":"const methodForValidation = 'getXMLWait';\n{ const methodForValidation = 'getXML'; new GlideAjax('UnseenAsyncReader')[methodForValidation](function() {}); }","expected":[],"limitations":[],"rationale":"内側の非同期API名を外側の同期API名で上書きしない。"},
    {"id":"CONST-J05","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"known_local_receiver","code":"const localForValidation = { getXMLWait: function() { return 'not-remote'; } };\nconst keyForValidation = 'getXML' + 'Wait';\nlocalForValidation[keyForValidation]();","expected":[],"limitations":[],"rationale":"API名が一致しても既知ローカル受信側は除外する。"},
    {"id":"CONST-J06","rule_id":"AU-CL-004","basis":"semantic_boundary","scenario":"mutable_binding_excluded","code":"let methodForValidation = 'getXMLWait';\nnew GlideAjax('UnseenMutableReader')[methodForValidation]();","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"letの値追跡は今回のconst限定契約の範囲外。"}
  ]
}
