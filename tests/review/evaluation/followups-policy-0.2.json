  "cases":[
    {"id":"NEXT-W01","rule_id":"AU-BR-001","basis":"catalog_contract","variant":"ordinary","scenario":"ordinary_branch_update","code":"const scheduled = current.getValue('u_batch');\nif (scheduled) current.update('scheduled-save');","expected":[{"line":2,"followup":false}],"limitations":[],"rationale":"通常の再更新候補にはworkflow確認を付けない。"},
    {"id":"NEXT-W02","rule_id":"AU-BR-001","basis":"catalog_contract","variant":"ordinary","scenario":"ordinary_array_update","code":"const queueForSave = [current];\nqueueForSave[0].update('queue-save');","expected":[{"line":2,"followup":false}],"limitations":[],"rationale":"別名だけではworkflowの付与条件にならない。"},
    {"id":"NEXT-W03","rule_id":"AU-BR-001","basis":"catalog_contract","variant":"defensive","scenario":"suppression_in_old_entry","code":"repairEntry(current, previous);\nfunction repairEntry(current, previous) {\n  current.setWorkflow(false);\n  current.update('repair-entry-save');\n}","expected":[{"line":4,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"抑止を含む旧入口では関連の確認が必要。"},
    {"id":"NEXT-W04","rule_id":"AU-BR-001","basis":"catalog_contract","variant":"defensive","scenario":"suppression_reenabled","code":"(function executeRule(current, previous) {\n  current.setWorkflow(false);\n  current.setWorkflow(true);\n  current.update('restored-hooks-save');\n})(current, previous);","expected":[{"line":4,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"再有効化後も関連の確認であり、抑止効果の断定ではない。"},
    {"id":"NEXT-W05","rule_id":"AU-BR-001","basis":"catalog_contract","variant":"control","scenario":"foreign_workflow_call","code":"const secondaryRow = new GlideRecord('u_secondary_row');\nsecondaryRow.setWorkflow(false);\ncurrent.update('primary-row-save');","expected":[{"line":3,"followup":false}],"limitations":[],"rationale":"他レコードの抑止から文脈項目を誤付与しない。"},
    {"id":"NEXT-W06","rule_id":"AU-BR-001","basis":"catalog_contract","variant":"control","scenario":"shadowed_local_update","code":"function localRepair(current) { current.setWorkflow(false); current.update(); }\nlocalRepair({ setWorkflow() {}, update() {} });","expected":[],"limitations":[],"rationale":"ローカル引数の同名APIは候補でも確認対象でもない。"},
    {"id":"NEXT-W07","rule_id":"AU-BR-001","basis":"semantic_boundary","variant":"boundary","scenario":"constant_ternary_false","code":"current.setWorkflow(true ? false : true);\ncurrent.update('ternary-argument-save');","expected":[{"line":2,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"定数式評価は現在のリテラル契約の外。"},
    {"id":"NEXT-W08","rule_id":"AU-BR-001","basis":"semantic_boundary","variant":"boundary","scenario":"helper_effect","code":"function prepareRepair(target) { target.setWorkflow(false); }\nprepareRepair(current);\ncurrent.update('prepared-save');","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"関数間の抑止効果は未対応。将来の制限語彙は別途設計する。"},
    {"id":"NEXT-A01","rule_id":"AU-BR-002","basis":"catalog_contract","variant":"ordinary","scenario":"unguarded_previous_field","when":"async_always","code":"const previousCode = previous.u_code;\ngs.info(previousCode);","expected":[{"line":1,"followup":true}],"limitations":[],"rationale":"通常の非同期依存候補にも必須項目を付ける。"},
