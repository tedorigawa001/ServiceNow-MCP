    {"id":"NEXT-J05","rule_id":"AU-CL-004","basis":"catalog_contract","variant":"control","scenario":"asynchronous_request","code":"const asyncUiRequest = new GlideAjax('PolicyDeferredReader');\nasyncUiRequest.getXMLAnswer(function(answer) { g_form.setValue('u_policy_answer', answer); });","expected":[],"limitations":[],"rationale":"非同期APIから同期固有項目を生成しない。"},
