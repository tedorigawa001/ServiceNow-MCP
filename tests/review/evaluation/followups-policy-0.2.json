    {"id":"NEXT-A03","rule_id":"AU-BR-002","basis":"catalog_contract","variant":"defensive","scenario":"previous_fallback","when":"async_always","code":"const fallbackCode = previous ? previous.getValue('u_code') : current.getValue('u_code');\ngs.info(fallbackCode);","expected":[{"line":1,"followup":true}],"limitations":[],"rationale":"フォールバックがあっても例外承認とはせず同じ必須項目を付ける。"},
