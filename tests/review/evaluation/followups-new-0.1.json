{
  "version": "followups-new-0.1",
  "provenance": "36 newly authored synthetic scenarios. Author has seen the engine and prior tests. Not blind, IID, human-adjudicated or production data. Expectations frozen before first measurement; no detector tuning in this evaluation. Semantic boundary cases deliberately exceed the declared catalog contract.",
  "cases": [
    {"id":"NEW-W01","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"per_finding_order","code":"current.update('first-pass');\ncurrent['setWorkflow'](false);\ncurrent.update('second-pass');","expected":[{"line":1,"followup":false},{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"最初の更新には抑止を付けず、後の更新だけに付ける。"},
    {"id":"NEW-W02","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"fixed_container_alias","code":"const bundle = { row: current };\nbundle.row['setWorkflow'](false);\nbundle.row.update('batch-a');","expected":[{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"固定キーとブラケット表記を組み合わせた受信側。"},
    {"id":"NEW-W03","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"conditional_possible_relation","code":"let recordForRepair = current;\nif (gs.hasRole('repair_operator')) recordForRepair.setWorkflow(false);\nrecordForRepair.update('conditional-repair');","expected":[{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"抑止効果を断定せず、可能な関連として確認する。"},
    {"id":"NEW-W04","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"unrelated_record","code":"const unrelated = new GlideRecord('u_separate');\nunrelated.setWorkflow(false);\ncurrent.update('separate-update');","expected":[{"line":3,"followup":false}],"limitations":[],"rationale":"別レコードへの抑止はcurrent更新の確認項目にしない。"},
    {"id":"NEW-W05","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"uninvoked_other_function","code":"function dormantPreparation() { current.setWorkflow(false); }\ncurrent.update('no-preparation');","expected":[{"line":2,"followup":false}],"limitations":[],"rationale":"呼んでいない別関数の抑止から項目を付けない。"},
    {"id":"NEW-W06","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"nonliteral_argument","code":"const guidance = 'setWorkflow(false) is discussed here';\ncurrent.setWorkflow('false');\ncurrent.update(guidance);","expected":[{"line":3,"followup":false}],"limitations":[],"rationale":"文字列のfalseと説明文を真偽値falseにしない。"},
    {"id":"NEW-W07","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"entry_and_loop","code":"(function executeRule(current, previous) {\n  for (let attempt = 0; attempt < 1; attempt++) { current.setWorkflow(false); }\n  current.update('entry-loop');\n})(current, previous);","expected":[{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"標準入口とループ内の可能な抑止を組み合わせる。"},
    {"id":"NEW-W08","rule_id":"AU-BR-001","basis":"catalog_contract","scenario":"rebound_receiver","code":"let repairReceiver = current;\nrepairReceiver = { setWorkflow: function(value) { return value; } };\nrepairReceiver.setWorkflow(false);\ncurrent.update('local-suppression');","expected":[{"line":4,"followup":false}],"limitations":[],"rationale":"再束縛後のローカル受信側への抑止は無関係。"},
    {"id":"NEW-W09","rule_id":"AU-BR-001","basis":"semantic_boundary","scenario":"constant_false_variable","code":"const disableHooks = false;\ncurrent.setWorkflow(disableHooks);\ncurrent.update('constant-argument');","expected":[{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"意味上はfalseだが定数評価は現契約の範囲外。"},
    {"id":"NEW-W10","rule_id":"AU-BR-001","basis":"semantic_boundary","scenario":"constant_false_expression","code":"current.setWorkflow(false || false);\ncurrent.update('expression-argument');","expected":[{"line":2,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"論理式を評価すればfalseだがリテラル条件の範囲外。"},
    {"id":"NEW-W11","rule_id":"AU-BR-001","basis":"semantic_boundary","scenario":"helper_suppression","code":"function disableForRepair(row) { row.setWorkflow(false); }\ndisableForRepair(current);\ncurrent.update('helper-repair');","expected":[{"line":3,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"抑止が関数をまたぐため現実装は関連を追跡しない。"},
    {"id":"NEW-W12","rule_id":"AU-BR-001","basis":"semantic_boundary","scenario":"caller_suppression","code":"function persistRepair() { current.update('caller-controlled'); }\ncurrent.setWorkflow(false);\npersistRepair();","expected":[{"line":1,"followup":true}],"limitations":["workflow_suppression_relation_not_verified"],"rationale":"呼出し時には抑止後だが、同一関数・ソース順だけでは関連を捉えない。"},
    {"id":"NEW-A01","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"previous_container","when":"async_always","code":"const priorVersions = { row: previous };\nconst oldState = priorVersions.row['getValue']('state');\ngs.info(oldState);","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"previousを固定キー経由で参照する非同期本文。"},
    {"id":"NEW-A02","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"legacy_entry","when":"async_always","code":"auditAsync(current, previous);\nfunction auditAsync(current, previous) {\n  current.install_status.changesTo('retired');\n}","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"旧入口の変更判定を現行保存値で検証する。"},
    {"id":"NEW-A03","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"multiple_dependencies","when":"async_always","code":"const wasPresent = previous ? previous.getValue('u_stage') : null;\nconst stageChanged = current.u_stage.changesFrom('draft');","expected":[{"line":1,"followup":true},{"line":2,"followup":true}],"limitations":[],"rationale":"ガード付きpreviousと変更判定の両指摘に確認が必要。"},
    {"id":"NEW-A04","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"display_context","when":"before_display","code":"const displayedValue = previous.getValue('u_label');\ncurrent.u_label.changesTo(displayedValue);","expected":[],"limitations":[],"rationale":"display保存値では非同期依存の項目を出さない。"},
    {"id":"NEW-A05","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"shadowed_previous","when":"async_always","code":"const readLocal = (previous) => previous.u_snapshot;\nreadLocal({ u_snapshot: 'cached' });","expected":[],"limitations":[],"rationale":"引数で束縛したpreviousをプラットフォーム由来にしない。"},
    {"id":"NEW-A06","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"local_changes_method","when":"async_always","code":"class ChangeMemo { changesFrom(value) { return value === 'memo'; } }\nnew ChangeMemo().changesFrom('memo');","expected":[],"limitations":[],"rationale":"独自クラスの変更判定風メソッドは対象外。"},
    {"id":"NEW-A07","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"condition_only","when":"async_always","condition":"current.u_gate.changesTo('ready')","code":"const gate = current.getValue('u_gate');\ngs.info('gate=' + gate);","expected":[],"limitations":[],"rationale":"条件欄だけのchangesを本文の依存に混ぜない。"},
    {"id":"NEW-A08","rule_id":"AU-BR-002","basis":"catalog_contract","scenario":"field_shadowing","when":"async_always","code":"{ const item = { changes: () => false }; item.changes(); }\nconst actualField = current.u_route;\nactualField.changes();","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"ローカルと本物のフィールドを区別し、後者だけに付ける。"},
    {"id":"NEW-A09","rule_id":"AU-BR-002","basis":"semantic_boundary","scenario":"previous_return_flow","when":"async_always","code":"function priorForAudit() { return previous; }\npriorForAudit().getValue('u_transition');","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"戻り値経由のprevious依存は関数間解析が必要。"},
    {"id":"NEW-A10","rule_id":"AU-BR-002","basis":"semantic_boundary","scenario":"field_argument_flow","when":"async_always","code":"function didRouteChange(field) { return field.changesTo('primary'); }\ndidRouteChange(current.u_route);","expected":[{"line":1,"followup":true}],"limitations":[],"rationale":"関数引数を経由したフィールド由来の追跡。"},
    {"id":"NEW-A11","rule_id":"AU-BR-002","basis":"semantic_boundary","scenario":"dynamic_changes_name","when":"async_always","code":"current.u_route['changes' + 'From']('secondary');","expected":[{"line":1,"followup":true}],"limitations":[],"rationale":"定数文字列結合を含むメソッド名。"},
    {"id":"NEW-A12","rule_id":"AU-BR-002","basis":"semantic_boundary","scenario":"destructuring_alias","when":"async_always","code":"const { older } = { older: previous };\nolder.getValue('u_route');","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"分割代入で取り出すprevious別名は現実装の範囲外。"},
    {"id":"NEW-J01","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"constructor_and_array","code":"const RemoteQuery = GlideAjax;\nconst requests = [new RemoteQuery('UiReviewLookup')];\nrequests[0]['getXMLWait']();","expected":[{"line":3,"followup":true}],"limitations":[],"rationale":"コンストラクタ別名と配列を組み合わせた同期候補。"},
    {"id":"NEW-J02","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"unresolved_parameter","code":"function onLoad(connection) {\n  connection.getXMLWait();\n}","expected":[{"line":2,"followup":true}],"limitations":["synchronous_ajax_receiver_unresolved"],"rationale":"未解決受信側には確認と型未確定の制限を付ける。"},
    {"id":"NEW-J03","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"local_class","code":"class UiMemo { getXMLWait() { return '<memo/>'; } }\nconst memoClient = new UiMemo();\nmemoClient.getXMLWait();","expected":[],"limitations":[],"rationale":"既知の独自クラスはGlideAjaxとして扱わない。"},
