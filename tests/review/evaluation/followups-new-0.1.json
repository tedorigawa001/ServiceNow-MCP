    {"id":"NEW-J11","rule_id":"AU-CL-004","basis":"semantic_boundary","scenario":"remote_factory","code":"function createRemoteUiClient() { return new GlideAjax('FactoryUiLookup'); }\ncreateRemoteUiClient().getXMLWait();","expected":[{"line":2,"followup":true}],"limitations":["synchronous_ajax_receiver_unresolved"],"rationale":"戻り値由来は解決できなくても、未解決の同期候補として確認を残せる。"},
    {"id":"NEW-J12","rule_id":"AU-CL-004","basis":"semantic_boundary","scenario":"local_factory","code":"function createLocalUiClient() { return { getXMLWait() { return 'offline-memo'; } }; }\ncreateLocalUiClient().getXMLWait();","expected":[],"limitations":[],"rationale":"意味上はローカル受信側だが、関数間の戻り値を未解決にすると誤候補・誤付与が起き得る。"}
