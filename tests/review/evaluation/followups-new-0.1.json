    {"id":"NEW-J05","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"literal_and_comment","code":"const warning = 'getXMLWait() should be reviewed';\n// requests.getXMLWait();\ng_form.addInfoMessage(warning);","expected":[],"limitations":[],"rationale":"文字列・コメントだけから項目を出さない。"},
    {"id":"NEW-J06","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"optional_invocation","code":"const optionalRequest = new GlideAjax('OptionalUiLookup');\noptionalRequest?.getXMLWait();","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"optional呼出しでも同期候補の確認を残す。"},
    {"id":"NEW-J07","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"mixed_receivers","code":"const localRequest = { getXMLWait() { return 'memo'; } };\nlocalRequest.getXMLWait();\nconst remoteRequest = new GlideAjax('ActualUiLookup');\nremoteRequest.getXMLWait();","expected":[{"line":4,"followup":true}],"limitations":[],"rationale":"同じファイルでも実際の同期候補だけに付ける。"},
    {"id":"NEW-J08","rule_id":"AU-CL-004","basis":"catalog_contract","scenario":"async_only","code":"const deferredRequest = new GlideAjax('DeferredUiLookup');\ndeferredRequest.getXML(function(reply) { g_form.setValue('u_reply', reply); });","expected":[],"limitations":[],"rationale":"非同期APIだけなら同期確認項目は不要。"},
    {"id":"NEW-J09","rule_id":"AU-CL-004","basis":"semantic_boundary","scenario":"computed_wait_name","code":"const synchronousRequest = new GlideAjax('ComputedUiLookup');\nsynchronousRequest['getXML' + 'Wait']();","expected":[{"line":2,"followup":true}],"limitations":[],"rationale":"文字列結合による同期API名は範囲外。"},
